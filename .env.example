# Leave blank to run in MOCK mode (no external API calls, fully offline/testable)
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Which provider to use: "anthropic" | "groq" | "mock"
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6

# Mock service ports
NETWORK_API_PORT=8001
TICKETING_API_PORT=8002
ORCHESTRATOR_PORT=8000
